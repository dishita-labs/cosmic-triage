{
  "name": "cosmic-triage-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "types": "json2ts -i src/types/contracts.schema.json -o src/types/contracts.ts --unreachableDefinitions --additionalProperties false"
  },
  "dependencies": {
    "plotly.js-dist-min": "^2.35.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/plotly.js": "^2.33.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
