# Copy to .env and fill in. Never commit .env. Values are read by cosmic_triage.settings.get_secret().
# Claude (Investigator extractor; M2+). Paid — requires an owner-approved spend budget.
ANTHROPIC_API_KEY=
# Jev via TypeSafe (preferred) or OpenRouter (§2.3). Paid — requires an owner-approved spend budget.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# Lasair (free): https://lasair-ztf.lsst.ac.uk -> profile -> API token
LASAIR_TOKEN=
# TNS bot (free): https://www.wis-tns.org -> My account -> Bots -> Add bot
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=
# NASA ADS (optional, literature grounding; M5+)
ADS_TOKEN=
# Runtime switches
# COSMIC_OFFLINE=1   (tests force this; no network)
# COSMIC_CACHE_DIR=data/cache
